# Optional: enables model-backed grounded answer synthesis on the backend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# For Groq, keep the key in .env and use a model ID enabled in your Groq account:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile
# Groq uses JSON-object mode for compatibility; other OpenAI-compatible providers
# use strict JSON Schema mode.

# Separate Google Places key for live place discovery (hotels, hostels, food and activities).
# This is not booking inventory: it does not provide room availability or pricing.
GOOGLE_PLACES_API_KEY=

# Optional comma-separated origins for a separately deployed frontend.
CORS_ORIGINS=

# RailRadar live train timetable/status API. Store only the token, or a pasted
# "Authorization: Bearer ..." value, in IRCTC_API_KEY (the backend normalizes it).
IRCTC_API_KEY=
IRCTC_API_BASE_URL=https://api.railradar.in/v1
# Aviationstack live flight status / airport lookup. The key alone is enough;
# the base URL override is optional and defaults to the public Aviationstack host.
AVIATIONSTACK_API_KEY=
AVIATIONSTACK_API_BASE_URL=https://api.aviationstack.com/v1

# Optional Gemini API credential (kept separate from the configured OpenAI model).
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
